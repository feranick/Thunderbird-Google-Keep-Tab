{
  "manifest_version": 2,
  "name": "Google Keep Tab",
  "description": "__MSG_extensionDescription__",
  "version": "0.4.0",
  "author": "Nicola Ferralis",
  "homepage_url": "https://github.com/feranick/Thunderbird-Google-Keep-Tab/",
  "browser_specific_settings": {
    "gecko": {
      "id": "feranick.google-keep-tab@addons.thunderbird.net",
      "strict_min_version": "106.0"
    }
  },  
  "permissions": [
    "menus",
    "webRequest",
    "webRequestBlocking",
    "https://*.google.com/*"
  ],
  "default_locale": "en",
  "icons": {
    "32": "skin/google_keep_icon.svg",
    "48": "skin/google_keep_icon.svg",
    "96": "skin/google_keep_icon.svg"
  },
  "background": {
    "scripts": [
      "redirect.js"
    ]
  }
}
